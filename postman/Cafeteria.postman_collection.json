{
  "info": {
    "name": "Cafeteria API",
    "_postman_id": "cafeteria-api-collection",
    "description": "Colección para el taller de API REST — Cafetería con JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token",   "value": "" }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "1a. Login válido → 200 + token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "  console.log('Token guardado en variable de colección');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"barista@cafeteria.com\",\n  \"password\": \"Cafeteria2026!\"\n}"
            }
          }
        },
        {
          "name": "1b. Login contraseña incorrecta → 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"barista@cafeteria.com\",\n  \"password\": \"contraseña_incorrecta\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "CRUD PRODUCTOS",
      "item": [
        {
          "name": "2a. Crear producto → 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/productos",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Café Latte\",\n  \"precio\": 8.50,\n  \"categoria\": \"bebida_caliente\",\n  \"disponible\": true\n}"
            }
          }
        },
        {
          "name": "2b. Listar productos → 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "2c. Obtener por ID → 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/productos/:id",
              "host": ["{{baseUrl}}"],
              "path": ["productos", ":id"],
              "variable": [{ "key": "id", "value": "PEGAR_ID_AQUI" }]
            }
          }
        },
        {
          "name": "3. Actualizar precio → 200",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 12.00,\n  \"disponible\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/:id",
              "host": ["{{baseUrl}}"],
              "path": ["productos", ":id"],
              "variable": [{ "key": "id", "value": "PEGAR_ID_AQUI" }]
            }
          }
        },
        {
          "name": "5. Eliminar producto → 200",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/productos/:id",
              "host": ["{{baseUrl}}"],
              "path": ["productos", ":id"],
              "variable": [{ "key": "id", "value": "PEGAR_ID_AQUI" }]
            }
          }
        }
      ]
    },
    {
      "name": "SEGURIDAD JWT",
      "item": [
        {
          "name": "6a. Sin token → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "6b. Token inválido (alterado) → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos",
            "header": [{ "key": "Authorization", "value": "Bearer TOKEN_ALTERADO_AQUI" }]
          }
        },
        {
          "name": "6c. Token vencido → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos",
            "header": [{ "key": "Authorization", "value": "Bearer TOKEN_VENCIDO_AQUI" }]
          }
        }
      ]
    },
    {
      "name": "VALIDACIONES",
      "item": [
        {
          "name": "7. Crear sin nombre → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/productos",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 5.00\n}"
            }
          }
        }
      ]
    }
  ]
}
